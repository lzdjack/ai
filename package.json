{
  "name": "cloudcraft",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "云匠（CLOUDCRAFT）：设计、方案与代码单仓",
  "packageManager": "pnpm@12.23.0",
  "engines": {
    "node": "^24.0.0"
  },
  "scripts": {
    "prepare": "lefthook install",
    "verify": "node tools/verify.mjs",
    "gen": "node tools/gen.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint . --max-warnings 0 --cache --cache-location node_modules/.cache/eslint/",
    "format": "prettier --write .",
    "test": "vitest run",
    "dev:up": "tsx tools/dev/up.ts",
    "dev:down": "tsx tools/dev/down.ts",
    "dev:reset": "tsx tools/dev/reset.ts",
    "fixtures:seed": "tsx tools/fixtures/seed.ts",
    "fixtures:check": "tsx tools/fixtures/check.ts",
    "sandbox:try": "tsx tools/sandbox/try.ts",
    "llm:check": "tsx tools/llm/check.ts",
    "runner": "node --import tsx apps/bot-executor/src/main.ts",
    "runner:try": "tsx tools/runner/try.ts",
    "runner:fix": "tsx tools/runner/fix.ts",
    "runner:browser": "tsx tools/runner/browser.ts",
    "accounts:try": "tsx tools/accounts/try.ts",
    "llm-proxy": "node --import tsx apps/llm-proxy/src/main.ts",
    "dev": "turbo run dev"
  },
  "devDependencies": {
    "@eslint-community/eslint-plugin-eslint-comments": "4.8.1",
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.4",
    "eslint": "10.15.0",
    "globals": "17.14.0",
    "lefthook": "2.2.4",
    "prettier": "3.10.1",
    "secretlint": "14.1.0",
    "tsx": "4.23.15",
    "turbo": "2.11.13",
    "typescript": "6.0.3",
    "typescript-eslint": "8.74.0",
    "vitest": "5.1.2"
  }
}
